{
  "name": "openman",
  "version": "0.2.0",
  "description": "OpenMan: a 100% local, auto-starting desktop AI agent that runs entirely on your laptop — no cloud, no accounts.",
  "private": true,
  "scripts": {
    "dev": "cross-env OPENMAN_LOCAL_MODE=1 next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit -p .",
    "lint": "eslint",
    "local:test": "node scripts/local-mode-test.mjs",
    "safe-fetch-test": "node scripts/safe-fetch-test.mjs",
    "redact-test": "node src/lib/observability/redact.test.mjs",
    "bootstrap": "tsx scripts/bootstrap.mjs",
    "agent": "tsx scripts/run-local-agent.mjs",
    "desktop:dev": "cross-env OPENMAN_LOCAL_MODE=1 tsx scripts/desktop-dev.mjs",
    "desktop:build": "next build && tsc -p electron/tsconfig.json && node scripts/prepare-desktop.mjs",
    "dist:win": "npm run desktop:build && electron-builder --config electron-builder.yml --win --x64 --arm64 --ia32",
    "dist:linux": "npm run desktop:build && electron-builder --config electron-builder.yml --linux",
    "dist:mac": "npm run desktop:build && electron-builder --config electron-builder.yml --mac",
    "dist:all": "node scripts/dist-all.mjs",
    "local:production-test": "node scripts/local-production-smoke.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "clsx": "^2.1.1",
    "eventsource-parser": "^4.1.3",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "playwright-core": "^1.65.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "electron": "42.11.18",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickvasilescu/openman.git"
  },
  "main": "build/electron/electron/main.js",
  "author": {
    "name": "Organic Intelligence, Inc."
  }
}
